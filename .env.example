# Supabase Auth user authorized to access the admin panel.
ADMIN_EMAIL="admin@example.com"
# Configure apenas no ambiente privado do servidor; nunca use o prefixo NEXT_PUBLIC_.
# Use uma chave aleatória com pelo menos 32 caracteres para ADMIN_SESSION_SECRET.
# Do not commit the session secret or service role key.
ADMIN_SESSION_SECRET="ALTERAR_POR_UMA_CHAVE_SEGURA"
SUPABASE_URL="https://SEU-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="CONFIGURE_NO_AMBIENTE_PRIVADO_DO_SERVIDOR"
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="CHAVE_PUBLICA_ANON_DO_PROJETO"
